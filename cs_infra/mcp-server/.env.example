# Supabase 配置（在 Supabase Dashboard → Settings → API 中获取）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# FCM 配置（在 Firebase Console → Project Settings → Service Accounts 中生成）
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# MCP Server 端口（Railway 会自动设置 PORT 环境变量）
PORT=3000

# 可选：访问鉴权 token（Cursor mcp.json 中配置 x-mcp-secret 头）
MCP_SECRET=
